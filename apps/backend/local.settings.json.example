{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",

    "// Database (Azure PostgreSQL Flexible Server)": "",
    "DATABASE_URL": "postgresql://vtadmin:{PASSWORD}@psql-vacationtimeline-{ENV}.postgres.database.azure.com/vacationtimeline?sslmode=require",

    "// Staffbase User API (for user/manager info)": "",
    "STAFFBASE_API_KEY": "your-staffbase-api-key",
    "STAFFBASE_API_URL": "https://yourcompany.staffbase.com",

    "// Azure AD App Registration (required for Graph API)": "",
    "TENANT_ID": "your-azure-tenant-id",
    "CLIENT_ID": "your-app-client-id",
    "CLIENT_SECRET": "your-app-client-secret",

    "// Calendar Configuration": "",
    "CALENDAR_MODE": "shared",
    "VACATION_CALENDAR_MAILBOX": "vacations@yourcompany.com",
    "VACATION_CATEGORY": "Vacation",

    "// Security": "",
    "API_KEY": "your-secure-api-key-here",
    "ALLOWED_ORIGINS": "https://your-staffbase-domain.staffbase.com",

    "// API Configuration (for email action links)": "",
    "API_BASE_URL": "https://func-vacationtimeline-prod.azurewebsites.net/api",

    "// Optional Settings": "",
    "MAX_DATE_RANGE_DAYS": "90",
    "DEFAULT_TIMEZONE": "UTC",
    "LOG_LEVEL": "info"
  },
  "Host": {
    "CORS": "*",
    "CORSCredentials": false
  }
}
